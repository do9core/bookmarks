{
    "version": "0.1.39",
    "description": "An open-source IDE inspired by IntelliJ IDEA, built with Rust and Tauri.",
    "homepage": "https://github.com/l0ng-ai/openidea",
    "license": "Apache-2.0",
    "notes": [
        "Update with 'scoop update openidea' instead of the in-app updater.",
        "Normal uninstall keeps user data. 'scoop uninstall openidea --purge' also removes this user's OpenIDEA settings, plugins, credentials and caches, including data shared with standalone installations. Project files are kept."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/l0ng-ai/openidea/releases/download/v0.1.39/OpenIDEA_0.1.39_x64-setup.exe#/dl.7z",
            "hash": "409cedcca711a65aa478ef44e9fd9ddfbe71be0ac9a6a2cee4056b688d264c5b"
        },
        "arm64": {
            "url": "https://github.com/l0ng-ai/openidea/releases/download/v0.1.39/OpenIDEA_0.1.39_arm64-setup.exe#/dl.7z",
            "hash": "600c4800379f24143ec13717ca2e6c5e6b142727a741babcf0b2bf745e8cca3c"
        }
    },
    "pre_install": "Remove-Item -LiteralPath \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Recurse -Force -ErrorAction Stop",
    "bin": "openidea.exe",
    "shortcuts": [
        [
            "openidea.exe",
            "OpenIDEA"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    foreach ($root in @($env:APPDATA, $env:LOCALAPPDATA)) {",
        "        if ($root) {",
        "            $data = Join-Path $root 'ai.l0ng.openidea'",
        "            if (Test-Path -LiteralPath $data) { Remove-Item -LiteralPath $data -Recurse -Force -ErrorAction Stop }",
        "        }",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/l0ng-ai/openidea/releases/download/v$version/OpenIDEA_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/l0ng-ai/openidea/releases/download/v$version/OpenIDEA_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
