{
    "version": "0.1.571-beta",
    "description": "Open source singing synthesis platform",
    "homepage": "https://github.com/openutau/OpenUtau/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/openutau/OpenUtau/releases/download/0.1.571-beta/OpenUtau-win-x64.zip",
            "hash": "f01d6253b4385fcb4c55dab775d337abcdccdae48866e2c1ba9dbbafd7ddec6a"
        }
    },
    "bin": [
        [
            "OpenUtau.exe",
            "openutau-beta"
        ]
    ],
    "shortcuts": [
        [
            "OpenUtau.exe",
            "OpenUtau Beta"
        ]
    ],
    "persist": [
        "Backups",
        "Cache",
        ["Dictionaries", "../openutau/Dictionaries"],
        "Plugins",
        ["Resamplers", "../openutau/Resamplers"],
        ["Singers", "../openutau/Singers"],
        ["Templates", "../openutau/Templates"],
        ["Wavtools", "../openutau/Wavtools"]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/openutau/OpenUtau/releases?per_page=100",
        "regex": "\"tag_name\":\\s*\"([\\d.]+-beta)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openutau/OpenUtau/releases/download/$version/OpenUtau-win-x64.zip"
            }
        }
    },
    "notes": [
        "Shares Dictionaries, Resamplers, Singers, Templates and Wavtools with openutau; Backups, Cache and Plugins remain private.",
        "Existing data in $persist_dir is preserved; merge only shared folders into $persist_dir/../openutau manually if needed.",
        "Purging openutau removes shared data used by all variants."
    ]
}
