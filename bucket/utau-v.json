{
    "version": "1.2.0.9",
    "description": "Open singing synthesis platform / Open source UTAU successor",
    "homepage": "https://github.com/emeraldsingers/UtauV",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/emeraldsingers/UtauV/releases/download/1.2.0.9/OpenUtau-win-x64.zip",
            "hash": "fdb280a76615581b19bc11fe512d4ecf1216663fb65ed4ebffaeb011af35f27a"
        }
    },
    "bin": [
        [
            "OpenUtau.exe",
            "utauv"
        ]
    ],
    "shortcuts": [
        [
            "OpenUtau.exe",
            "UtauV"
        ]
    ],
    "persist": [
        "Backups",
        "Cache",
        ["Dictionaries", "../openutau/Dictionaries"],
        "Plugins",
        ["Resamplers", "../openutau/Resamplers"],
        ["Singers", "../openutau/Singers"],
        ["Templates", "../openutau/Templates"],
        ["Wavtools", "../openutau/Wavtools"],
        "Dependencies",
        "Logs",
        "SingerThemes",
        "Themes"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/emeraldsingers/UtauV/releases/download/$version/OpenUtau-win-x64.zip"
            }
        }
    },
    "notes": [
        "Shares Dictionaries, Resamplers, Singers, Templates and Wavtools with openutau; Backups, Cache and Plugins remain private.",
        "Existing data in $persist_dir is preserved; merge only shared folders into $persist_dir/../openutau manually if needed.",
        "Purging openutau removes shared data used by all variants."
    ]
}
