{
    "version": "0.0.1.1",
    "description": "Open singing synthesis platform / Open source UTAU successor",
    "homepage": "https://github.com/emeraldsingers/UtauV",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/emeraldsingers/UtauV/releases/download/0.0.1.1/UtauV-win-x64-directml.zip",
            "hash": "5a9de79ce2595e81cf25a4ce9e0f8be49f68b0a92695ab9a4b74fa5c8ec2fc85"
        }
    },
    "extract_dir": "bin",
    "bin": [
        [
            "UtauV.exe",
            "utauv"
        ]
    ],
    "shortcuts": [
        [
            "UtauV.exe",
            "UtauV"
        ]
    ],
    "persist": [
        "Backups",
        "Cache",
        ["Dictionaries", "../openutau/Dictionaries"],
        "Plugins",
        ["Resamplers", "../openutau/Resamplers"],
        ["Singers", "../openutau/Singers"],
        ["Templates", "../openutau/Templates"],
        ["Wavtools", "../openutau/Wavtools"],
        "Dependencies",
        "Logs",
        "SingerThemes",
        "Themes"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/emeraldsingers/UtauV/releases/download/$version/UtauV-win-x64-directml.zip"
            }
        }
    },
    "notes": [
        "Uses the DirectML build. Upstream reset version numbering from 1.2.x to 0.0.x; reinstall utau-v to switch to this release.",
        "Shares Dictionaries, Resamplers, Singers, Templates and Wavtools with openutau; Backups, Cache and Plugins remain private.",
        "Existing data in $persist_dir is preserved; merge only shared folders into $persist_dir/../openutau manually if needed.",
        "Purging openutau removes shared data used by all variants."
    ]
}
